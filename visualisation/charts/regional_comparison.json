{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "padding": {"top": 14, "left": 5, "right": 5, "bottom": 5},
  "title": {
    "text": "Ireland's Regional Employment Gap Fell from 3.8 to 1.4 Percentage Points",
    "subtitle": "Employment rates across Ireland's three NUTS 2 regions - Gap = highest minus lowest regional rate",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#1A1A1A",
    "subtitleFont": "Arial",
    "subtitleFontSize": 14,
    "subtitleColor": "#666666",
    "subtitlePadding": 10,
    "offset": 25
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Lidia-Vill/unequal-opportunities-infovis/refs/heads/main/labour_market.csv"
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [2020, 2021, 2022, 2023, 2024, 2025],
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum['Statistic Label'] === 'Annual employment rate' && datum['Age Group'] === 'All ages' && datum.Sex === 'Both sexes' && datum['Education Attainment Level'] === 'Levels of Education (Levels  0-8)'"
    },
    {
      "filter": "datum['NUTS 2 Region'] !== 'Ireland' && toNumber(datum.Year) >= 2019 && toNumber(datum.Year) <= 2025"
    },
    {
      "calculate": "datum['NUTS 2 Region'] === 'Northern and Western' ? 'IE04' : datum['NUTS 2 Region'] === 'Southern' ? 'IE05' : 'IE06'",
      "as": "nutsCode"
    },
    {"calculate": "toNumber(datum.Year)", "as": "yearNum"},
    {"calculate": "toNumber(datum.VALUE)", "as": "rate"},
    {
      "aggregate": [{"op": "mean", "field": "rate", "as": "rate"}],
      "groupby": ["NUTS 2 Region", "nutsCode", "yearNum"]
    },
    {
      "pivot": "yearNum",
      "value": "rate",
      "groupby": ["NUTS 2 Region", "nutsCode"]
    },
    {"calculate": "datum['2019']", "as": "baselineRate"},
    {"calculate": "datum[toString(selectedYear)]", "as": "selectedRate"},
    {"filter": "isValid(datum.baselineRate) && isValid(datum.selectedRate)"},
    {
      "joinaggregate": [
        {"op": "max", "field": "baselineRate", "as": "baselineMax"},
        {"op": "min", "field": "baselineRate", "as": "baselineMin"},
        {"op": "max", "field": "selectedRate", "as": "selectedMax"},
        {"op": "min", "field": "selectedRate", "as": "selectedMin"}
      ]
    },
    {"calculate": "datum.baselineMax - datum.baselineMin", "as": "baselineGap"},
    {"calculate": "datum.selectedMax - datum.selectedMin", "as": "selectedGap"},
    {"calculate": "datum.selectedGap - datum.baselineGap", "as": "gapChange"},
    {
      "calculate": "format(datum.baselineRate, '.1f') + '%'",
      "as": "baselineLabel"
    },
    {
      "calculate": "format(datum.selectedRate, '.1f') + '%'",
      "as": "selectedLabel"
    },
    {
      "calculate": "datum.nutsCode === 'IE04' ? 'Northern & Western' : datum.nutsCode === 'IE05' ? 'Southern' : 'Eastern & Midland'",
      "as": "regionLabel"
    },
    {
      "calculate": "datum.nutsCode === 'IE04' ? -8.85 : datum.nutsCode === 'IE05' ? -8.4 : -7.1",
      "as": "labelLongitude"
    },
    {
      "calculate": "datum.nutsCode === 'IE04' ? 53.9 : datum.nutsCode === 'IE05' ? 52.4 : 53.4",
      "as": "labelLatitude"
    },
    {"calculate": "toString(selectedYear)", "as": "selectedYearLabel"},
    {
      "calculate": "selectedYear === 2025 ? '#E69A45' : '#526B83'",
      "as": "selectedYearColor"
    },
    {
      "lookup": "nutsCode",
      "from": {
        "data": {
          "url": "https://gisco-services.ec.europa.eu/distribution/v2/nuts/geojson/NUTS_RG_20M_2024_4326_LEVL_2.geojson",
          "format": {"type": "json", "property": "features"}
        },
        "key": "properties.NUTS_ID",
        "fields": ["geometry"]
      }
    }
  ],
  "vconcat": [
    {
      "hconcat": [
        {
          "width": 420,
          "height": 465,
          "title": {
            "text": "2019",
            "anchor": "middle",
            "font": "Arial",
            "fontSize": 18,
            "fontWeight": "bold",
            "color": "#388A83",
            "offset": 12
          },
          "projection": {
            "type": "mercator",
            "fit": {
              "type": "FeatureCollection",
              "features": [
                {
                  "type": "Feature",
                  "geometry": {"type": "Point", "coordinates": [-10.7, 51.3]},
                  "properties": {}
                },
                {
                  "type": "Feature",
                  "geometry": {"type": "Point", "coordinates": [-5.3, 55.5]},
                  "properties": {}
                }
              ]
            }
          },
          "layer": [
            {
              "mark": {
                "type": "geoshape",
                "stroke": "#FFFFFF",
                "strokeWidth": 1.5
              },
              "encoding": {
                "shape": {"field": "geometry", "type": "geojson"},
                "color": {
                  "field": "baselineRate",
                  "type": "quantitative",
                  "scale": {
                    "domain": [72, 82],
                    "range": [
                      "#EDF7F0",
                      "#C9E8D3",
                      "#91CDA9",
                      "#4F9D78",
                      "#216647"
                    ],
                    "clamp": true
                  },
                  "legend": null
                },
                "tooltip": null
              }
            },
            {
              "mark": {
                "type": "text",
                "font": "Arial",
                "fontSize": 12,
                "fontWeight": "bold",
                "align": "center",
                "baseline": "middle",
                "dy": -10
              },
              "encoding": {
                "longitude": {
                  "field": "labelLongitude",
                  "type": "quantitative"
                },
                "latitude": {"field": "labelLatitude", "type": "quantitative"},
                "text": {"field": "regionLabel", "type": "nominal"},
                "color": {
                  "condition": {
                    "test": "datum.baselineRate >= 80.5",
                    "value": "#FFFFFF"
                  },
                  "value": "#173D2C"
                },
                "tooltip": null
              }
            },
            {
              "mark": {
                "type": "text",
                "font": "Arial",
                "fontSize": 14,
                "fontWeight": "bold",
                "align": "center",
                "baseline": "middle",
                "dy": 11
              },
              "encoding": {
                "longitude": {
                  "field": "labelLongitude",
                  "type": "quantitative"
                },
                "latitude": {"field": "labelLatitude", "type": "quantitative"},
                "text": {"field": "baselineLabel", "type": "nominal"},
                "color": {
                  "condition": {
                    "test": "datum.baselineRate >= 80.5",
                    "value": "#FFFFFF"
                  },
                  "value": "#173D2C"
                },
                "tooltip": null
              }
            }
          ]
        },
        {
          "width": 420,
          "height": 465,
          "projection": {
            "type": "mercator",
            "fit": {
              "type": "FeatureCollection",
              "features": [
                {
                  "type": "Feature",
                  "geometry": {"type": "Point", "coordinates": [-10.7, 51.3]},
                  "properties": {}
                },
                {
                  "type": "Feature",
                  "geometry": {"type": "Point", "coordinates": [-5.3, 55.5]},
                  "properties": {}
                }
              ]
            }
          },
          "layer": [
            {
              "mark": {
                "type": "geoshape",
                "stroke": "#FFFFFF",
                "strokeWidth": 1.5
              },
              "encoding": {
                "shape": {"field": "geometry", "type": "geojson"},
                "color": {
                  "field": "selectedRate",
                  "type": "quantitative",
                  "scale": {
                    "domain": [72, 82],
                    "range": [
                      "#EDF7F0",
                      "#C9E8D3",
                      "#91CDA9",
                      "#4F9D78",
                      "#216647"
                    ],
                    "clamp": true
                  },
                  "legend": null
                },
                "tooltip": null
              }
            },
            {
              "transform": [{"filter": "datum.nutsCode === 'IE04'"}],
              "mark": {
                "type": "text",
                "font": "Arial",
                "fontSize": 18,
                "fontWeight": "bold",
                "align": "center",
                "baseline": "middle"
              },
              "encoding": {
                "x": {"value": 210},
                "y": {"value": -23},
                "text": {"field": "selectedYearLabel", "type": "nominal"},
                "color": {
                  "condition": {
                    "test": "selectedYear === 2025",
                    "value": "#E69A45"
                  },
                  "value": "#526B83",
                  "legend": null
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "font": "Arial",
                "fontSize": 12,
                "fontWeight": "bold",
                "align": "center",
                "baseline": "middle",
                "dy": -10
              },
              "encoding": {
                "longitude": {
                  "field": "labelLongitude",
                  "type": "quantitative"
                },
                "latitude": {"field": "labelLatitude", "type": "quantitative"},
                "text": {"field": "regionLabel", "type": "nominal"},
                "color": {
                  "condition": {
                    "test": "datum.selectedRate >= 79",
                    "value": "#E8EBE0"
                  },
                  "value": "#173D2C"
                },
                "tooltip": null
              }
            },
            {
              "mark": {
                "type": "text",
                "font": "Arial",
                "fontSize": 14,
                "fontWeight": "bold",
                "align": "center",
                "baseline": "middle",
                "dy": 11
              },
              "encoding": {
                "longitude": {
                  "field": "labelLongitude",
                  "type": "quantitative"
                },
                "latitude": {"field": "labelLatitude", "type": "quantitative"},
                "text": {"field": "selectedLabel", "type": "nominal"},
                "color": {
                  "condition": {
                    "test": "datum.selectedRate >= 79",
                    "value": "#E8EBE0"
                  },
                  "value": "#173D2C"
                },
                "tooltip": null
              }
            }
          ]
        }
      ],
      "spacing": 16,
      "resolve": {"scale": {"color": "shared"}}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Arial"
  }
}