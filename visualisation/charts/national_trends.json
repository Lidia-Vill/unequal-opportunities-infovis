{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/Lidia-Vill/unequal-opportunities-infovis/refs/heads/main/labour_market.csv",
    "format": {"type": "csv"}
  },
  "padding": {"left": 10, "right": 20, "top": 10, "bottom": 20},
  "title": {
    "text": ["Ireland's Employment Rate Rose by 5.1 Points to 80% in 2025"],
    "subtitle": "National employment and unemployment rates, 2019-2025",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#1A1A1A",
    "subtitleFont": "Arial",
    "subtitleFontSize": 14,
    "subtitleColor": "#666666",
    "subtitlePadding": 8,
    "offset": 20
  },
  "transform": [
    {"filter": "datum['Age Group'] === 'All ages'"},
    {"filter": "datum.Sex === 'Both sexes'"},
    {
      "filter": "datum['Education Attainment Level'] === 'Levels of Education (Levels  0-8)'"
    },
    {"filter": "datum['NUTS 2 Region'] === 'Ireland'"},
    {
      "filter": "datum['Statistic Label'] === 'Annual employment rate' || datum['Statistic Label'] === 'Annual unemployment rate'"
    },
    {"calculate": "toNumber(datum.VALUE)", "as": "value"},
    {"pivot": "Statistic Label", "value": "value", "groupby": ["Year"]},
    {"calculate": "datum['Annual employment rate']", "as": "Employment"},
    {"calculate": "datum['Annual unemployment rate']", "as": "Unemployment"},
    {"fold": ["Employment", "Unemployment"], "as": ["measure", "rate"]},
    {"calculate": "format(datum.rate, '.1f') + '%'", "as": "label"}
  ],
  "vconcat": [
    {
      "title": {
        "text": "Employment rate (%) · starting at 70%",
        "anchor": "start",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "normal",
        "color": "#595959",
        "offset": -8
      },
      "width": 650,
      "height": 190,
      "transform": [
        {"filter": "datum.measure === 'Employment'"},
        {"calculate": "datum.rate - 0.9", "as": "annotationY"},
        {"calculate": "datum.rate - 0.65", "as": "annotationEnd"}
      ],
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "sort": "ascending",
          "title": null,
          "axis": null
        },
        "y": {
          "field": "rate",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [70, 82], "zero": false},
          "axis": {
            "values": [70, 75, 80],
            "labelPadding": 12,
            "labelColor": "#595959"
          }
        }
      },
      "layer": [
        {"mark": {"type": "line", "stroke": "#5B6B7A", "strokeWidth": 3}},
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 50,
            "color": "#5B6B7A",
            "opacity": 1
          }
        },
        {
          "transform": [{"filter": "datum.Year == 2025"}],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 130,
            "color": "#E69A45"
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#B0B0B0",
            "strokeWidth": 1,
            "strokeDash": [4, 4]
          },
          "encoding": {
            "opacity": {
              "condition": [
                {"param": "hoverEmployment", "empty": false, "value": 1},
                {"param": "hoverUnemployment", "empty": false, "value": 1}
              ],
              "value": 0
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 150,
            "color": "#28A745"
          },
          "encoding": {
            "opacity": {
              "condition": [
                {"param": "hoverEmployment", "empty": false, "value": 1},
                {"param": "hoverUnemployment", "empty": false, "value": 1}
              ],
              "value": 0
            }
          }
        },
        {
          "transform": [{"filter": "datum.Year == 2019 || datum.Year == 2025"}],
          "mark": {
            "type": "text",
            "dy": -14,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#333333"
          },
          "encoding": {"text": {"field": "label"}}
        },
        {
          "transform": [{"filter": "datum.Year == 2020"}],
          "mark": {
            "type": "rule",
            "stroke": "#A45D3E",
            "strokeWidth": 1.2,
            "strokeDash": [3, 3]
          },
          "encoding": {"y2": {"field": "annotationEnd"}}
        },
        {
          "transform": [{"filter": "datum.Year == 2020"}],
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#A45D3E",
            "align": "center",
            "baseline": "top"
          },
          "encoding": {
            "y": {"field": "annotationY", "type": "quantitative"},
            "text": {"value": "2020 decline"}
          }
        },
        {
          "transform": [{"filter": "datum.Year == 2020"}],
          "mark": {
            "type": "text",
            "fontSize": 10,
            "color": "#A45D3E",
            "align": "center",
            "baseline": "top",
            "dy": 14
          },
          "encoding": {
            "y": {"field": "annotationY", "type": "quantitative"},
            "text": {"value": "COVID-19 period"}
          }
        },
        {
          "params": [
            {
              "name": "hoverEmployment",
              "select": {
                "type": "point",
                "fields": ["Year"],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ],
          "mark": {"type": "rect", "color": "#FFFFFF", "opacity": 0.001},
          "encoding": {
            "y": {"value": 0},
            "y2": {"value": 190},
            "tooltip": [
              {"field": "Year", "type": "ordinal", "title": "Year"},
              {
                "field": "Employment",
                "type": "quantitative",
                "title": "🟢 Employment (%)",
                "format": ".1f"
              },
              {
                "field": "Unemployment",
                "type": "quantitative",
                "title": "🔵 Unemployment (%)",
                "format": ".1f"
              }
            ]
          }
        }
      ]
    },
    {
      "title": {
        "text": "Unemployment rate (%)",
        "anchor": "start",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "normal",
        "color": "#595959",
        "offset": 12
      },
      "width": 650,
      "height": 190,
      "transform": [{"filter": "datum.measure === 'Unemployment'"}],
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "sort": "ascending",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelPadding": 8,
            "labelColor": "#595959",
            "grid": false
          }
        },
        "y": {
          "field": "rate",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [0, 8], "zero": true},
          "axis": {
            "values": [0, 2, 4, 6, 8],
            "labelPadding": 12,
            "labelColor": "#595959"
          }
        }
      },
      "layer": [
        {"mark": {"type": "line", "stroke": "#5B6B7A", "strokeWidth": 3}},
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 50,
            "color": "#5B6B7A",
            "opacity": 1
          }
        },
        {
          "transform": [{"filter": "datum.Year == 2025"}],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 130,
            "color": "#C4772E"
          }
        },
        {
          "mark": {
            "type": "rule",
            "color": "#B0B0B0",
            "strokeWidth": 1,
            "strokeDash": [4, 4]
          },
          "encoding": {
            "opacity": {
              "condition": [
                {"param": "hoverEmployment", "empty": false, "value": 1},
                {"param": "hoverUnemployment", "empty": false, "value": 1}
              ],
              "value": 0
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 150,
            "color": "#3478B8"
          },
          "encoding": {
            "opacity": {
              "condition": [
                {"param": "hoverEmployment", "empty": false, "value": 1},
                {"param": "hoverUnemployment", "empty": false, "value": 1}
              ],
              "value": 0
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.Year == 2019 || datum.Year == 2021 || datum.Year == 2023 || datum.Year == 2025"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -14,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#333333"
          },
          "encoding": {"text": {"field": "label"}}
        },
        {
          "params": [
            {
              "name": "hoverUnemployment",
              "select": {
                "type": "point",
                "fields": ["Year"],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ],
          "mark": {"type": "rect", "color": "#FFFFFF", "opacity": 0.001},
          "encoding": {
            "y": {"value": 0},
            "y2": {"value": 190},
            "tooltip": [
              {"field": "Year", "type": "ordinal", "title": "Year"},
              {
                "field": "Employment",
                "type": "quantitative",
                "title": "🟢 Employment (%)",
                "format": ".1f"
              },
              {
                "field": "Unemployment",
                "type": "quantitative",
                "title": "🔵 Unemployment (%)",
                "format": ".1f"
              }
            ]
          }
        }
      ]
    }
  ],
  "spacing": 45,
  "resolve": {"scale": {"x": "shared", "y": "independent"}},
  "config": {
    "view": {"stroke": null},
    "axis": {
      "grid": true,
      "gridColor": "#E5E7EB",
      "gridOpacity": 0.7,
      "domain": false,
      "ticks": false,
      "labelColor": "#595959",
      "labelFontSize": 12,
      "titleColor": "#595959",
      "titleFontWeight": "normal",
      "titleFontSize": 13
    }
  }
}