{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "data": {
    "url": "https://raw.githubusercontent.com/Lidia-Vill/unequal-opportunities-infovis/refs/heads/main/labour_market.csv",
    "format": {"type": "csv"}
  },
  "title": {
    "text": "Employment Rates Remain Far Apart Across Education Levels",
    "subtitle": "Employment rates by highest educational attainment in Ireland, 2019-2025",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#1A1A1A",
    "subtitleFont": "Arial",
    "subtitleFontSize": 14,
    "subtitleColor": "#666666",
    "subtitlePadding": 10,
    "offset": 18
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [2019, 2020, 2021, 2022, 2023, 2024, 2025],
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum['Statistic Label'] === 'Annual employment rate' && datum.Sex === 'Both sexes' && datum['NUTS 2 Region'] === 'Ireland' && datum['Age Group'] === 'All ages'"
    },
    {"filter": "toNumber(datum.Year) >= 2019 && toNumber(datum.Year) <= 2025"},
    {
      "calculate": "datum['Education Attainment Level']",
      "as": "educationOriginal"
    },
    {
      "calculate": "indexof(datum.educationOriginal, 'Tertiary education') >= 0 ? 'Tertiary' : indexof(datum.educationOriginal, 'Upper secondary') >= 0 ? 'Upper secondary & post-secondary' : indexof(datum.educationOriginal, 'Primary and lower secondary') >= 0 ? 'Primary & lower secondary' : null",
      "as": "education"
    },
    {"filter": "isValid(datum.education)"},
    {"calculate": "toNumber(datum.Year)", "as": "yearNum"},
    {"calculate": "toNumber(datum.VALUE)", "as": "rate"},
    {
      "aggregate": [{"op": "mean", "field": "rate", "as": "rate"}],
      "groupby": ["education", "yearNum"]
    },
    {"pivot": "yearNum", "value": "rate", "groupby": ["education"]},
    {"calculate": "datum[toString(selectedYear)]", "as": "selectedRate"},
    {"calculate": "datum['2019']", "as": "baselineRate"},
    {"filter": "isValid(datum.selectedRate) && isValid(datum.baselineRate)"},
    {
      "joinaggregate": [
        {"op": "max", "field": "selectedRate", "as": "maxRate"},
        {"op": "min", "field": "selectedRate", "as": "minRate"},
        {"op": "max", "field": "baselineRate", "as": "maxBaseline"},
        {"op": "min", "field": "baselineRate", "as": "minBaseline"}
      ]
    },
    {"calculate": "datum.maxRate - datum.minRate", "as": "educationGap"},
    {"calculate": "datum.maxBaseline - datum.minBaseline", "as": "baselineGap"},
    {"calculate": "datum.educationGap - datum.baselineGap", "as": "gapChange"},
    {"calculate": "format(datum.selectedRate, '.1f') + '%'", "as": "rateLabel"},
    {
      "calculate": "format(datum.educationGap, '.1f') + ' pp'",
      "as": "gapLabel"
    },
    {
      "calculate": "'EMPLOYMENT GAP · ' + toString(selectedYear)",
      "as": "gapHeading"
    },
    {
      "calculate": "selectedYear == 2019 ? 'Baseline year' : format(datum.gapChange, '+.1f') + ' pp since 2019 (' + (datum.gapChange > 0.05 ? 'widened' : datum.gapChange < -0.05 ? 'narrowed' : 'unchanged') + ')'",
      "as": "changeLabel"
    }
  ],
  "vconcat": [
    {
      "width": 720,
      "height": 125,
      "layer": [
        {
          "transform": [{"filter": "datum.education === 'Tertiary'"}],
          "mark": {"type": "rect", "color": "#F5F7F9", "cornerRadius": 6},
          "encoding": {
            "x": {"value": 0},
            "x2": {"value": 720},
            "y": {"value": 0},
            "y2": {"value": 125}
          }
        },
        {
          "transform": [{"filter": "datum.education === 'Tertiary'"}],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#526B83",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {"value": 22},
            "y": {"value": 22},
            "text": {"field": "gapHeading", "type": "nominal"}
          }
        },
        {
          "transform": [{"filter": "datum.education === 'Tertiary'"}],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 28,
            "fontWeight": "bold",
            "color": "#1F2D3A",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {"value": 30},
            "y": {"value": 53},
            "text": {"field": "gapLabel", "type": "nominal"}
          }
        },
        {
          "transform": [{"filter": "datum.education === 'Tertiary'"}],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 11,
            "color": "#595959",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {"value": 22},
            "y": {"value": 83},
            "text": {"value": "Highest minus lowest education level"}
          }
        },
        {
          "transform": [{"filter": "datum.education === 'Tertiary'"}],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#53697e",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {"value": 22},
            "y": {"value": 106},
            "text": {"field": "changeLabel", "type": "nominal"}
          }
        },
        {
          "transform": [{"filter": "datum.education === 'Tertiary'"}],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#526B83",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {"value": 365},
            "y": {"value": 23},
            "text": {"value": "Gap over time"}
          }
        },
        {
          "transform": [
            {
              "fold": ["2019", "2020", "2021", "2022", "2023", "2024", "2025"],
              "as": ["yearString", "yearRate"]
            },
            {"filter": "isValid(datum.yearRate)"},
            {
              "aggregate": [
                {"op": "max", "field": "yearRate", "as": "highest"},
                {"op": "min", "field": "yearRate", "as": "lowest"}
              ],
              "groupby": ["yearString"]
            },
            {"calculate": "toNumber(datum.yearString)", "as": "sparkYear"},
            {"calculate": "datum.highest - datum.lowest", "as": "sparkGap"}
          ],
          "layer": [
            {
              "mark": {
                "type": "line",
                "stroke": "#526B83",
                "strokeWidth": 2.5,
                "strokeCap": "round",
                "strokeJoin": "round"
              },
              "encoding": {
                "x": {
                  "field": "sparkYear",
                  "type": "quantitative",
                  "scale": {
                    "domain": [2019, 2025],
                    "range": [365, 650],
                    "nice": false
                  },
                  "axis": null
                },
                "y": {
                  "field": "sparkGap",
                  "type": "quantitative",
                  "scale": {
                    "domain": [27, 35],
                    "range": [88, 40],
                    "nice": false
                  },
                  "axis": null
                },
                "order": {"field": "sparkYear", "type": "quantitative"},
                "tooltip": [
                  {
                    "field": "sparkYear",
                    "type": "quantitative",
                    "title": "Year",
                    "format": ".0f"
                  },
                  {
                    "field": "sparkGap",
                    "type": "quantitative",
                    "title": "Gap (pp)",
                    "format": ".1f"
                  }
                ]
              }
            },
            {
              "transform": [{"filter": "datum.sparkYear === 2019"}],
              "mark": {
                "type": "point",
                "filled": true,
                "size": 90,
                "color": "#388A83"
              },
              "encoding": {
                "x": {
                  "field": "sparkYear",
                  "type": "quantitative",
                  "scale": {
                    "domain": [2019, 2025],
                    "range": [365, 650],
                    "nice": false
                  },
                  "axis": null
                },
                "y": {
                  "field": "sparkGap",
                  "type": "quantitative",
                  "scale": {
                    "domain": [27, 35],
                    "range": [88, 40],
                    "nice": false
                  },
                  "axis": null
                }
              }
            },
            {
              "transform": [{"filter": "datum.sparkYear === 2025"}],
              "mark": {
                "type": "point",
                "filled": true,
                "size": 100,
                "color": "#E69A45"
              },
              "encoding": {
                "x": {
                  "field": "sparkYear",
                  "type": "quantitative",
                  "scale": {
                    "domain": [2019, 2025],
                    "range": [365, 650],
                    "nice": false
                  },
                  "axis": null
                },
                "y": {
                  "field": "sparkGap",
                  "type": "quantitative",
                  "scale": {
                    "domain": [27, 35],
                    "range": [88, 40],
                    "nice": false
                  },
                  "axis": null
                }
              }
            },
            {
              "transform": [
                {
                  "filter": "datum.sparkYear == selectedYear && selectedYear > 2019 && selectedYear < 2025"
                }
              ],
              "mark": {
                "type": "point",
                "filled": true,
                "size": 110,
                "color": "#E6B84A"
              },
              "encoding": {
                "x": {
                  "field": "sparkYear",
                  "type": "quantitative",
                  "scale": {
                    "domain": [2019, 2025],
                    "range": [365, 650],
                    "nice": false
                  },
                  "axis": null
                },
                "y": {
                  "field": "sparkGap",
                  "type": "quantitative",
                  "scale": {
                    "domain": [27, 35],
                    "range": [88, 40],
                    "nice": false
                  },
                  "axis": null
                }
              }
            }
          ]
        },
        {
          "transform": [{"filter": "datum.education === 'Tertiary'"}],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 10,
            "color": "#687782",
            "align": "left"
          },
          "encoding": {
            "x": {"value": 365},
            "y": {"value": 110},
            "text": {"value": "2019"}
          }
        },
        {
          "transform": [{"filter": "datum.education === 'Tertiary'"}],
          "mark": {
            "type": "text",
            "font": "Arial",
            "fontSize": 10,
            "color": "#687782",
            "align": "right"
          },
          "encoding": {
            "x": {"value": 650},
            "y": {"value": 110},
            "text": {"value": "2025"}
          }
        }
      ]
    },
    {
      "width": 720,
      "height": {"step": 62},
      "layer": [
        {
          "data": {
            "values": [
              {"tick": 0},
              {"tick": 20},
              {"tick": 40},
              {"tick": 60},
              {"tick": 80},
              {"tick": 100}
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#E8EDF1",
            "strokeWidth": 0.5,
            "opacity": 0.55
          },
          "encoding": {
            "x": {
              "field": "tick",
              "type": "quantitative",
              "scale": {"domain": [-34, 105], "nice": false},
              "axis": {
                "title": "Employment rate (%)",
                "titleFont": "Arial",
                "titleFontSize": 13,
                "titleFontWeight": "normal",
                "titleColor": "#595959",
                "titlePadding": 12,
                "labelFont": "Arial",
                "labelFontSize": 11,
                "labelColor": "#595959",
                "values": [0, 20, 40, 60, 80, 100],
                "grid": false,
                "domain": false,
                "ticks": false
              }
            }
          }
        },
        {
          "mark": {
            "type": "bar",
            "size": 22,
            "cornerRadiusEnd": 2,
            "color": "#526B83"
          },
          "encoding": {
            "x": {
              "field": "selectedRate",
              "type": "quantitative",
              "scale": {"domain": [-34, 105], "nice": false}
            },
            "x2": {"datum": 0},
            "y": {
              "field": "education",
              "type": "nominal",
              "sort": [
                "Tertiary",
                "Upper secondary & post-secondary",
                "Primary & lower secondary"
              ],
              "axis": null
            },
            "tooltip": null
          }
        },
        {
          "transform": [
            {"filter": "datum.education !== 'Upper secondary & post-secondary'"}
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -14,
            "font": "Arial",
            "fontSize": 12,
            "color": "#344454"
          },
          "encoding": {
            "x": {"datum": -2, "type": "quantitative"},
            "y": {
              "field": "education",
              "type": "nominal",
              "sort": [
                "Tertiary",
                "Upper secondary & post-secondary",
                "Primary & lower secondary"
              ],
              "axis": null
            },
            "text": {"field": "education", "type": "nominal"}
          }
        },
        {
          "transform": [
            {"filter": "datum.education === 'Upper secondary & post-secondary'"}
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -14,
            "dy": -9,
            "font": "Arial",
            "fontSize": 12,
            "color": "#344454"
          },
          "encoding": {
            "x": {"datum": -2, "type": "quantitative"},
            "y": {
              "field": "education",
              "type": "nominal",
              "sort": [
                "Tertiary",
                "Upper secondary & post-secondary",
                "Primary & lower secondary"
              ],
              "axis": null
            },
            "text": {"value": "Upper secondary &"}
          }
        },
        {
          "transform": [
            {"filter": "datum.education === 'Upper secondary & post-secondary'"}
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dx": -14,
            "dy": 9,
            "font": "Arial",
            "fontSize": 12,
            "color": "#344454"
          },
          "encoding": {
            "x": {"datum": -2, "type": "quantitative"},
            "y": {
              "field": "education",
              "type": "nominal",
              "sort": [
                "Tertiary",
                "Upper secondary & post-secondary",
                "Primary & lower secondary"
              ],
              "axis": null
            },
            "text": {"value": "post-secondary"}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 9,
            "font": "Arial",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#263746"
          },
          "encoding": {
            "x": {"field": "selectedRate", "type": "quantitative"},
            "y": {
              "field": "education",
              "type": "nominal",
              "sort": [
                "Tertiary",
                "Upper secondary & post-secondary",
                "Primary & lower secondary"
              ],
              "axis": null
            },
            "text": {"field": "rateLabel", "type": "nominal"}
          }
        }
      ]
    }
  ],
  "spacing": 16,
  "resolve": {"scale": {"x": "independent", "y": "independent"}},
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "Arial", "titleFont": "Arial"}
  }
}