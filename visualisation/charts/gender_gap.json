{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/Lidia-Vill/unequal-opportunities-infovis/refs/heads/main/labour_market.csv",
    "format": {"type": "csv"}
  },
  "title": {
    "text": "Ireland's Gender Employment Gap Has Narrowed by 4.1 Points",
    "subtitle": "Gender differences in Ireland, 2019-2025",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#1A1A1A",
    "subtitleFont": "Arial",
    "subtitleFontSize": 14,
    "subtitleColor": "#666666",
    "subtitlePadding": 10,
    "offset": 18
  },
  "width": 680,
  "height": 320,
  "padding": {"left": 10, "right": 100, "top": 10, "bottom": 15},
  "transform": [
    {"filter": "datum['Statistic Label'] === 'Annual employment rate'"},
    {"filter": "datum['Age Group'] === 'All ages'"},
    {"filter": "datum['NUTS 2 Region'] === 'Ireland'"},
    {
      "filter": "datum['Education Attainment Level'] === 'Levels of Education (Levels  0-8)'"
    },
    {"filter": "datum.Sex === 'Male' || datum.Sex === 'Female'"},
    {"calculate": "toNumber(datum.VALUE)", "as": "rate"},
    {"pivot": "Sex", "value": "rate", "groupby": ["Year"]},
    {"calculate": "datum.Male - datum.Female", "as": "gap"},
    {"calculate": "(datum.Male + datum.Female) / 2", "as": "midpoint"},
    {"calculate": "format(datum.gap, '.1f') + ' pp'", "as": "gapLabel"},
    {"fold": ["Male", "Female"], "as": ["Sex", "rate"]}
  ],
  "layer": [
    {
      "data": {"values": [{"label": "Employment rate (%) · starting at 60%"}]},
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 13,
        "fontWeight": "normal",
        "color": "#595959",
        "align": "left",
        "baseline": "bottom"
      },
      "encoding": {
        "x": {"value": -22},
        "y": {"value": -24},
        "text": {"field": "label"}
      }
    },
    {
      "transform": [{"filter": "datum.Sex === 'Female'"}],
      "mark": {"type": "area", "color": "#9CA3AF", "opacity": 0.16},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "Female", "type": "quantitative"},
        "y2": {"field": "Male"}
      }
    },
    {
      "mark": {"type": "line", "strokeWidth": 3},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "rate", "type": "quantitative"},
        "color": {
          "field": "Sex",
          "type": "nominal",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#526B83", "#C05A85"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 55},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "rate", "type": "quantitative"},
        "color": {
          "field": "Sex",
          "type": "nominal",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#526B83", "#C05A85"]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2025"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "rate", "type": "quantitative"},
        "text": {"field": "Sex"},
        "color": {
          "field": "Sex",
          "type": "nominal",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#526B83", "#C05A85"]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [{"filter": "datum.Sex === 'Female' && datum.Year == 2019"}],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#555555"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "midpoint", "type": "quantitative"},
        "text": {"field": "gapLabel"}
      }
    },
    {
      "transform": [{"filter": "datum.Sex === 'Female' && datum.Year == 2025"}],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -6,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#555555"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "midpoint", "type": "quantitative"},
        "text": {"field": "gapLabel"}
      }
    },
    {
      "transform": [
        {"filter": "datum.Sex === 'Female'"},
        {"filter": {"param": "hoverGender", "empty": false}}
      ],
      "mark": {
        "type": "rule",
        "stroke": "#555555",
        "strokeWidth": 2,
        "strokeDash": [4, 4]
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "Female", "type": "quantitative"},
        "y2": {"field": "Male"}
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Sex === 'Female' && datum.Year != 2019 && datum.Year != 2025"
        },
        {"filter": {"param": "hoverGender", "empty": false}}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#444444"
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "midpoint", "type": "quantitative"},
        "text": {"field": "gapLabel"}
      }
    },
    {
      "transform": [{"filter": {"param": "hoverGender", "empty": false}}],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"field": "rate", "type": "quantitative"},
        "color": {
          "field": "Sex",
          "type": "nominal",
          "scale": {
            "domain": ["Male", "Female"],
            "range": ["#526B83", "#C05A85"]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [{"filter": "datum.Sex === 'Female'"}],
      "params": [
        {
          "name": "hoverGender",
          "select": {
            "type": "point",
            "fields": ["Year"],
            "on": "pointermove",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {"type": "rect", "color": "white", "opacity": 0.001},
      "encoding": {
        "x": {"field": "Year", "type": "ordinal"},
        "y": {"value": 0},
        "y2": {"value": 320}
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "sort": "ascending",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelPadding": 10,
        "labelColor": "#595959",
        "grid": false
      }
    },
    "y": {
      "type": "quantitative",
      "scale": {"domain": [60, 90], "zero": false},
      "title": null,
      "axis": {
        "values": [60, 65, 70, 75, 80, 85, 90],
        "labelPadding": 10,
        "labelColor": "#595959"
      }
    }
  },
  "config": {
    "view": {"stroke": null},
    "axis": {
      "grid": true,
      "gridColor": "#E5E7EB",
      "gridOpacity": 0.7,
      "domain": false,
      "ticks": false,
      "labelColor": "#595959",
      "labelFontSize": 13,
      "titleColor": "#595959",
      "titleFontWeight": "normal",
      "titleFontSize": 13
    }
  }
}